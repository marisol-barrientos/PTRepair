"/></graphical></parameter><parameter branchable="false" id="2" name="B"><graphical><style number="1"/><begin fill="true" style="5"/><middle fill="false" style="0"/><end fill="false" style="0"/></graphical></parameter></parameters><statemessages><message state="VIOLATED">&lt;html&gt;This constraint is violated because both tasks &amp;quot;A&amp;quot; and &amp;quot;B&amp;quot; were executed.&lt;/html&gt;</message><message state="SATISFIED">&lt;html&gt;This constraint is satisfied because either:&lt;ul&gt;
